
---
import SectionLayout from '../../layouts/SectionLayout.astro';
---

<SectionLayout title="Essays" description="Thoughts, reflections, and ideas.">
  <div class="categories">
    <a href="/essays/daily">Daily →</a>
    <a href="/essays/weekly">Weekly →</a>
    <a href="/essays/topics">Topics →</a>
  </div>
</SectionLayout>

<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .categories a {
    color: inherit;
    text-decoration: none;
    font-size: 1.2rem;
  }
  .categories a:hover {
    text-decoration: underline;
  }
</style>



---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bwlee42">
  <section class="home">
    <h1>Bwlee42's Archive</h1>

    <p>
      A little corner of the internet
      for things I find interesting.
    </p>

    <figure>
      <img
        src="/images/thinkfirst.webp"
        alt="Think First"
        loading="eager"
      />
    </figure>
  </section>
</BaseLayout>

<style>
  .home {
    max-width: 820px;
    margin: 0 auto;
    padding: 9vh 0 0;
  }

  .home h1 {
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 1.25rem;
  }

  .home p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }

  .home figure {
    margin: 0;
  }

  .home img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 720px) {
    .home {
      padding-top: 5vh;
    }
  }
</style>


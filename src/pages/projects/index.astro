
---
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';

const posts = await getCollection('projects', entry => !entry.data.draft);

const names = [...new Set(
  posts.map(post => post.slug.split('/')[1])
    .filter(Boolean)
)].sort();
---

<SectionLayout title="Projects" description="Building, experimenting, and exploring.">
  <div class="categories">
    {names.map(name => (
      <a href={`/projects/list/${name}`}>
        {name.replace(/-/g, ' ')} →
      </a>
    ))}
  </div>
</SectionLayout>

<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .categories a {
    color: inherit;
    text-decoration: none;
    font-size: 1.2rem;
    text-transform: capitalize;
  }
</style>

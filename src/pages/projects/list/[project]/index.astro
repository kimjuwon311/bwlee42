
---
import { getCollection } from 'astro:content';
import SectionLayout from '../../../../layouts/SectionLayout.astro';
import ArticleList from '../../../../components/ArticleList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('projects', entry => !entry.data.draft);
  const names = [...new Set(
    posts.map(post => post.slug.split('/')[1]).filter(Boolean)
  )];

  return names.map(project => ({
    params: { project },
  }));
}

const { project } = Astro.params;

const posts = (await getCollection('projects', entry =>
  !entry.data.draft &&
  entry.slug.startsWith(`list/${project}/`)
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SectionLayout title={project.replace(/-/g, ' ')}>
  <ArticleList posts={posts} basePath="/projects" />
</SectionLayout>
